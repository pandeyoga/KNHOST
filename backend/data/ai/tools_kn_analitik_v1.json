 {
  "type": "function",
  "name": "ops_metrics",
  "strict": true,
  "description": "Metrik operasional gudang, QC, makloon & supplier. supplier_performance = tepat waktu, lead time, kelengkapan qty, masalah QC per supplier; receiving_discrepancy = selisih qty surat jalan vs hitung fisik per GRN; dispatch_speed = hari dari SO sampai kirim per gudang; qc_results = hasil inspeksi (ditahan, warna/handfeel beda, poin cacat); makloon_wip = barang di vendor makloon + umur + selisih hasil.",
  "parameters": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "period",
    "limit"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "supplier_performance",
      "receiving_discrepancy",
      "dispatch_speed",
      "qc_results",
      "makloon_wip"
     ]
    },
    "period": {
     "anyOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "preset",
        "from",
        "to"
       ],
       "description": "Periode. Pakai preset bila cocok; custom memakai from/to (YYYY-MM-DD, inklusif, WIB).",
       "properties": {
        "preset": {
         "type": [
          "string",
          "null"
         ],
         "enum": [
          "today",
          "yesterday",
          "this_week",
          "last_week",
          "mtd",
          "last_month",
          "qtd",
          "last_quarter",
          "ytd",
          "last_year",
          "last_7d",
          "last_30d",
          "last_90d",
          "last_12m",
          "custom",
          null
         ]
        },
        "from": {
         "type": [
          "string",
          "null"
         ]
        },
        "to": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      },
      {
       "type": "null"
      }
     ]
    },
    "limit": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  }
 },
 {
  "type": "function",
  "name": "forecast",
  "strict": true,
  "description": "Perkiraan. stock_demand = kebutuhan stok per produk untuk horizon_weeks (4–8) + saran jumlah pesan ulang + hari cukup + supplier (id produk & supplier ikut untuk propose_action); cashflow = proyeksi arus kas dari piutang & hutang jatuh tempo; churn_risk = skor risiko pelanggan berhenti order. Selalu sebut sebagai perkiraan beserta dasarnya.",
  "parameters": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "horizon_weeks",
    "product_ids",
    "limit"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "stock_demand",
      "cashflow",
      "churn_risk"
     ]
    },
    "horizon_weeks": {
     "type": [
      "integer",
      "null"
     ]
    },
    "product_ids": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Kosongkan untuk semua produk; isi id dari find_entities bila menanyakan produk tertentu."
    },
    "limit": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  }
 },
 {
  "type": "function",
  "name": "propose_action",
  "strict": true,
  "description": "Siapkan DRAF tindakan yang baru dijalankan setelah pengguna menekan Setujui. draft_po = PO ke supplier (items: product_id + quantity dari forecast/stok; supplier otomatis dari master bila supplier_id null); collection_followup = pengingat tagih ke sales penanggung jawab pelanggan yang piutangnya lewat tempo (customer_ids kosong = semua); customer_followup = tugas follow-up pelanggan tidak aktif ke sales (customer_ids kosong = tidak order > 60 hari). Hanya panggil bila pengguna meminta atau jelas akan terbantu.",
  "parameters": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "action_type",
    "reason",
    "supplier_id",
    "customer_ids",
    "items",
    "note"
   ],
   "properties": {
